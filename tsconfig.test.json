{
  // Type-checks the tests with the sources: vitest runs them without checking types, so a test's
  // `@ts-expect-error` assertions are checked only here
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "test/_not_used"]
}
